# 🔑 Gemini API Keys (Multi-Key Pool for Infinite Quota Failover)
# Primary API key:
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Add multiple backup keys to automatically rotate when 429 quota exhaustion hits.
# Either as comma-separated keys:
# GEMINI_API_KEYS=key2,key3,key4
# Or numbered keys:
# GEMINI_API_KEY_1=key2
# GEMINI_API_KEY_2=key3

PLANNER_MODEL=gemini-3.5-flash-lite
GROUNDER_MODEL=gemini-3.5-flash-lite


# 🍌 AI Image Generation Models (Optional - Nano Banana / Gemini Native Image)
# Defaults cascade across: nano-banana-pro-preview, gemini-3.1-flash-lite-image, gemini-2.5-flash-image
# If free tier quota is 0, Castor automatically falls back to local Python Pillow/SVG generation!

# 🛡️ Safety & Execution Thresholds
# State-diff threshold: mean per-channel pixel diff below this = "screen didn't change" = action failed
SCREEN_DIFF_THRESHOLD=1.0

# Maximum number of planner steps before the loop self-terminates (safety guardrail)
MAX_STEPS=30

# Number of planner history turns to keep in context (prevents context window overflow)
HISTORY_WINDOW=10

# Max consecutive failed state-diffs before aborting (prevents runaway loops)
MAX_DIFF_RETRIES=3

# Bash command timeout in seconds
BASH_TIMEOUT=60.0

# Max characters of bash stdout/stderr sent to the model (prevents context flooding)
BASH_MAX_OUTPUT=2000
